<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="gameVM"
            type="com.example.curiocity.presentation.ui.question.GameViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".presentation.ui.question.GameFragment">

        <ImageView
            android:id="@+id/game_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/home_screen_background" />

        <TextView
            android:id="@+id/home_score_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="70dp"
            android:text="@{@string/home_score_text(gameVM.playerScore)}"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="@id/game_background"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="score: 10" />

        <TextView
            android:id="@+id/home_lives_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{@string/home_lives_text(gameVM.currentLives)}"
            app:layout_constraintStart_toStartOf="@id/home_score_text"
            app:layout_constraintTop_toBottomOf="@id/home_score_text"
            tools:text="lives: 3" />

        <include
            android:id="@+id/game_resource_layout"
            layout="@layout/layout_resource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="70dp"
            app:layout_constraintStart_toStartOf="@id/game_background"
            app:layout_constraintTop_toTopOf="@id/game_background" />

        <TextView
            android:id="@+id/game_level_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@{gameVM.gameLevelInfo}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="level: Sofia\nquestion: 2" />

        <TextView
            android:id="@+id/game_question_text"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/text_view_background"
            android:backgroundTint="@color/colorSecondary"
            android:gravity="center"
            android:padding="16dp"
            android:text="@{gameVM.questionString}"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/game_resource_layout"
            tools:text="In London who must study 2 to 4 years,
            memorizing iver 300 routes and thousands of
            landmarks before being allowed to work" />

        <com.example.curiocity.presentation.ui.custom.CooldownBarView
            android:id="@+id/game_timer_bar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/game_question_text" />


        <Button
            android:id="@+id/game_answer_1"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:text="@{gameVM.answerA}"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/game_timer_bar"
            tools:text="a walkable tunnel network stretching over 240 kilometers with unknown origins" />

        <Button
            android:id="@+id/game_answer_2"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:text="@{gameVM.answerB}"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/game_answer_1"
            tools:text="answer b" />

        <Button
            android:id="@+id/game_answer_3"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:text="@{gameVM.answerC}"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/game_answer_2"
            tools:text="answer c" />

        <Button
            android:id="@+id/game_answer_4"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:text="@{gameVM.answerD}"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/game_answer_3"
            tools:text="answer D" />

        <ProgressBar
            android:id="@+id/game_progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/colorSecondaryVariant"
            android:indeterminateTintMode="src_atop"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout> 